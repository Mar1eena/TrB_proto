{
  "name": "@marleena/trb-proto",
  "version": "1.0.14",
  "description": "Generated protobuf messages and gRPC-Web clients for TrB services",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mar1eena/TrB_proto.git"
  },
  "bugs": {
    "url": "https://github.com/Mar1eena/TrB_proto/issues"
  },
  "homepage": "https://github.com/Mar1eena/TrB_proto#readme",
  "files": [
    "gen/js-ts"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./*": "./gen/js-ts/*"
  },
  "typesVersions": {
    "*": {
      "*": [
        "gen/js-ts/*"
      ]
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "google-protobuf": "^3.21.4",
    "grpc-web": "^1.5.0"
  },
  "devDependencies": {
    "@types/google-protobuf": "^3.15.12"
  }
}
